# ArthSaathi AI — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Obtain credentials at:
#   API Key:    https://cloud.ibm.com/iam/apikeys
#   Project ID: https://dataplatform.cloud.ibm.com → Project → Manage → General

WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Optional Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=false
