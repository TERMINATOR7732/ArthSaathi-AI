# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml for local Streamlit development,
# or enter these key-value pairs into the "Secrets" settings in Streamlit Community Cloud.
# NEVER commit .streamlit/secrets.toml or real API keys to version control.

WATSONX_API_KEY = "your-ibm-watsonx-api-key"
WATSONX_PROJECT_ID = "your-watsonx-project-guid"
WATSONX_URL = "https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL_ID = "ibm/granite-4-h-small"
